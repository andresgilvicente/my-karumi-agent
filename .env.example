# karumi-agent configuration.
#
# Copy to `.env` and fill in only what the phase you are running needs.
# Phases 1 and 2 (browser spike, text-driven UI worker) need no credentials at
# all. This file contains no secrets and is safe to commit.

# ---------------------------------------------------------------------------
# Browser  (Phase 1+)
# ---------------------------------------------------------------------------

# The demo surface is a real, visible browser. Set true only for CI.
KARUMI_BROWSER_HEADLESS=false

# Explicit Chromium binary. Leave unset to let Playwright use its own managed
# download; set it when the image ships a Chromium whose build number does not
# match the installed Playwright (common in preprovisioned CI images).
# KARUMI_BROWSER_EXECUTABLE=/opt/pw-browsers/chromium

KARUMI_BROWSER_VIEWPORT_WIDTH=1440
KARUMI_BROWSER_VIEWPORT_HEIGHT=900

# Persistent profile directory. Point this at a profile that is already signed
# in to demo an authenticated product — the agent never handles credentials
# itself and will refuse to type into password fields regardless.
# KARUMI_BROWSER_USER_DATA_DIR=.browser-profile

KARUMI_BROWSER_NAV_TIMEOUT_MS=30000
KARUMI_BROWSER_ACTION_TIMEOUT_MS=8000

# How often the page pushes a new accessibility snapshot. Lower is fresher and
# costlier; the walker coalesces bursts of mutations within the window.
KARUMI_BROWSER_SNAPSHOT_DEBOUNCE_MS=250

# Tag nodes outside the viewport as [offscreen]. Costs a layout measurement per
# node; turn off only on very large pages where that shows up in the numbers.
KARUMI_BROWSER_TRACK_VIEWPORT=true

# How long to let the page react before verifying an action. Long enough for an
# SPA re-render, short enough to stay off the speech path.
KARUMI_BROWSER_SETTLE_MS=350

# Snapshot budget handed to the model. Exceeding it prunes offscreen material
# first; visible content is never elided.
KARUMI_BROWSER_MAX_NODES=1200
KARUMI_BROWSER_MAX_DEPTH=22

# When false, the demo is confined to the origin it started on. Turn on only
# for a product that genuinely spans domains.
KARUMI_BROWSER_ALLOW_CROSS_ORIGIN_NAVIGATION=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

KARUMI_LOG_LEVEL=INFO
KARUMI_LOG_DIR=logs
KARUMI_LOG_CONSOLE=true

# ---------------------------------------------------------------------------
# Providers  (Phase 3+ — not read before the voice pipeline exists)
# ---------------------------------------------------------------------------
# The reference low-latency stack. Every one of these is swappable behind the
# provider interfaces; these are defaults, not commitments.

# Speech-to-text — Deepgram Flux, whose end-of-turn detection is built into the
# model, removing a separate VAD/endpointing stage from the critical path.
# DEEPGRAM_API_KEY=

# Conversation and UI reasoning — Claude Haiku 4.5 (fastest Claude with solid
# tool calling). A stronger model for the interface-reasoning path is a
# measured decision, not a default: see docs/LIMITATIONS.md.
# ANTHROPIC_API_KEY=

# Provider selection. Both are read at Phase 2 (`karumi text`) and later.
# Providers: anthropic (default) | openai | google.
# KARUMI_LLM_PROVIDER=anthropic
# KARUMI_LLM_MODEL=claude-haiku-4-5

# Text-to-speech — Cartesia Sonic, currently the time-to-first-byte leader.
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
