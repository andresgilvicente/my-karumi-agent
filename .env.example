# Karumi Agent configuration.
#
# EVERY VALUE HERE IS OPTIONAL. The main flow runs with no API keys, no accounts
# and no cloud services. Copy to `.env` only if you want to change a default:
#
#     cp .env.example .env
#
# Nesting uses a double underscore: KARUMI_LLM__MODEL -> settings.llm.model

# --- What to demo -----------------------------------------------------------
# KARUMI_DEMO__URL=https://metric-master-suite505.apps.rebolt.ai/
# KARUMI_DEMO__EDITORIAL_CONFIG=configs/metric-master-suite.yaml
# KARUMI_DEMO__AUTONOMOUS=false

# --- Local LLM (Ollama) -----------------------------------------------------
# Run `karumi eval models` to measure candidates on your machine; the current
# default and the numbers behind it are in docs/BENCHMARKS.md.
# KARUMI_LLM__MODEL=qwen3:1.7b
# Optional: a separate, more capable model for reasoning over page structure.
# Leave unset to use one model for both and keep only one set of weights resident.
# KARUMI_LLM__UI_MODEL=
# KARUMI_LLM__NUM_CTX=8192
# KARUMI_LLM__BASE_URL=http://localhost:11434/v1

# --- Speech to text ---------------------------------------------------------
# auto | parakeet | whisper. `auto` prefers Parakeet when onnx-asr is installed.
# KARUMI_STT__ENGINE=auto

# --- Text to speech ---------------------------------------------------------
# KARUMI_TTS__VOICE=af_heart

# --- Turn taking / barge-in -------------------------------------------------
# Lower vad_start_secs interrupts the agent faster, at the cost of more false
# triggers from background noise.
# KARUMI_VOICE__VAD_START_SECS=0.12
# KARUMI_VOICE__TURN_STOP_SECS=2.0

# --- Browser ----------------------------------------------------------------
# The audience is meant to see the real browser, so headless is off by default.
# KARUMI_BROWSER__HEADLESS=false
# Set true only if WSLg / your display server cannot open a window.
# KARUMI_BROWSER__DISABLE_GPU=false

# --- Safety -----------------------------------------------------------------
# Sensitive actions (delete, pay, sign out, ...) ask for spoken confirmation.
# Turning this off is not recommended for a live demo.
# KARUMI_SAFETY__REQUIRE_CONFIRMATION=true
# KARUMI_SAFETY__RESTRICT_TO_ORIGIN=true

# --- Logging ----------------------------------------------------------------
# KARUMI_LOG_LEVEL=INFO
# JSONL run log. Share this file if you need to report a problem.
# KARUMI_LOG_FILE=~/.cache/karumi-agent/logs/karumi.jsonl

# ---------------------------------------------------------------------------
# NOTE: there is deliberately no API key of any kind in this file. If a future
# cloud provider is wired in, it belongs behind an explicit opt-in and must never
# become required for the main flow.
# ---------------------------------------------------------------------------
