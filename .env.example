# No environment variables are required. The default application stack runs locally.

# Optional backend diagnostics
# KARUMI_DEBUG_LOGS=true

# Frontend-only public configuration. Set this in the client process or a client env file.
# Vite exposes this value to browser code, so it is not a secret. The commented value is the default.
# VITE_PIPECAT_WEBRTC_URL=http://localhost:7860/api/offer
